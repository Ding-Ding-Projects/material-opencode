{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "Material Expressive",
  "id": "material-expressive",
  "light": {
    "palette": {
      "neutral": "#fef7ff",
      "ink": "#1d1b20",
      "primary": "#6750a4",
      "accent": "#7d5260",
      "success": "#386a20",
      "warning": "#7d5700",
      "error": "#b3261e",
      "info": "#00639b",
      "interactive": "#6750a4"
    },
    "overrides": {
      "text-weak": "#49454f",
      "syntax-comment": "#6b6670",
      "syntax-keyword": "#6750a4",
      "syntax-string": "#386a20",
      "syntax-primitive": "#00639b",
      "syntax-variable": "#1d1b20",
      "syntax-property": "#7d5260",
      "syntax-type": "#7d5700",
      "syntax-constant": "#b3261e",
      "syntax-operator": "#006a6a",
      "syntax-punctuation": "#49454f",
      "markdown-heading": "#6750a4",
