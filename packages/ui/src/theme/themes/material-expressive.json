      "syntax-variable": "#e6e0e9",
      "syntax-property": "#efb8c8",
      "syntax-type": "#f6be48",
      "syntax-constant": "#f2b8b5",
      "syntax-operator": "#4cdada",
      "syntax-punctuation": "#cac4d0",
      "markdown-heading": "#d0bcff",
      "markdown-text": "#e6e0e9",
      "markdown-link": "#98cbff",
      "markdown-code": "#efb8c8",
      "markdown-block-quote": "#cac4d0"
    }
  }
